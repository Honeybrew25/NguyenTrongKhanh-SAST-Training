{
  "schema_version": 1,
  "rules": {
    "root": "rules/semgrep-rules",
    "commit": "40b8c63f75dc7c22c8a77482d73bfb864b146f7e",
    "engines_share_rules": true
  },
  "scan": {
    "timeout_seconds_per_rule": 30,
    "max_target_bytes": 1000000,
    "jobs": 4,
    "respect_git_ignore": true,
    "exclude": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/venv/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/third_party/**",
      "**/*.min.js"
    ],
    "outputs": ["json", "sarif"]
  },
  "policy": {
    "scan_exact_vulnerable_commit": true,
    "preserve_raw_output": true,
    "unmatched_is_not_false_positive": true
  }
}
