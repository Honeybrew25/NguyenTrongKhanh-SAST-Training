      "**/.venv/**",
      "**/venv/**",
      "vendor",
      "dist",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/third_party/**",
      "**/*.min.js"
    ],
    "outputs": ["json", "sarif"]
  },
  "policy": {
    "scan_exact_vulnerable_commit": true,
    "preserve_raw_output": true,
    "unmatched_is_not_false_positive": true
  }
