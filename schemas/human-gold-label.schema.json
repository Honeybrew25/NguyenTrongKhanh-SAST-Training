{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vulngym/human-gold-label.schema.json",
  "title": "Independent human gold label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "label",
    "reason_codes",
    "reasoning",
    "reviewer",
    "reviewed_at",
    "evidence",
    "linked_entry_ids",
    "linked_report_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "label": {
      "enum": [
        "TP_KNOWN",
        "TP_NOVEL",
        "FP_CONFIRMED",
        "UNCERTAIN",
        "DUPLICATE",
        "OUT_OF_SCOPE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNREACHABLE_CODE",
          "NO_ATTACKER_CONTROL",
          "SANITIZED_BEFORE_SINK",
          "CONSTANT_VALUE",
          "AUTHZ_PRECONDITION_BLOCKS_ATTACK",
          "SAFE_API_USAGE",
          "TYPE_OR_SCHEMA_CONSTRAINT",
          "TEST_OR_FIXTURE_ONLY",
          "DEAD_OR_UNUSED_PATH",
          "FRAMEWORK_GUARANTEE",
          "SCANNER_MODELING_ERROR",
          "OTHER_EXPLAINED"
        ]
      }
    },
    "reasoning": {"type": "string", "minLength": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "HUMAN"}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "linked_entry_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^entry-[0-9]{5}$"}
    },
    "linked_report_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"label": {"const": "FP_CONFIRMED"}}},
      "then": {
        "properties": {
          "reason_codes": {"minItems": 1},
          "linked_entry_ids": {"maxItems": 0},
          "linked_report_ids": {"maxItems": 0}
        }
      },
      "else": {"properties": {"reason_codes": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"label": {"const": "TP_KNOWN"}}},
      "then": {
        "properties": {
          "linked_entry_ids": {"minItems": 1},
          "linked_report_ids": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "linked_entry_ids": {"maxItems": 0},
          "linked_report_ids": {"maxItems": 0}
        }
      }
    }
  ]
}
